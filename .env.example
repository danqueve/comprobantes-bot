# API key de Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# URL de la implementacion de Google Apps Script (termina en /exec)
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXX/exec

# IDs de los grupos de WhatsApp a monitorear, separados por coma
GRUPOS_PERMITIDOS=120363xxxxxxxx@g.us,120363yyyyyyyy@g.us

# Nombres de cada grupo, en el MISMO orden que GRUPOS_PERMITIDOS
# (define el nombre de la pestana en Google Sheets)
NOMBRES_GRUPOS=Zona Norte,Zona Sur
